# Copy to .env for local development. Never commit the real .env.

# SQLAlchemy database URL. docker-compose provides this value automatically;
# set it explicitly when running outside compose.
DATABASE_URL=postgresql+psycopg://gym:gym@localhost:5432/gym

# Set to true only for local debugging.
DEBUG=false

# Default UI language: "en" or "fa".
DEFAULT_LANGUAGE=en

# Signs the session cookie. Generate a fresh random value per deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-insecure-secret-change-me

# Set to true in production (served over HTTPS) so the session cookie is Secure.
SESSION_HTTPS_ONLY=false

# LLM provider for automated form guides / insights / quotes.
# "none" makes no network calls (default). "groq" uses api.groq.com (free tier,
# fast; set LLM_API_KEY). "ollama" uses a local server at LLM_BASE_URL.
LLM_PROVIDER=none
LLM_API_KEY=
# Leave blank to use the provider's default model, or pin one, e.g.
# llama-3.3-70b-versatile (groq) / llama3.1 (ollama).
LLM_MODEL=
LLM_BASE_URL=http://localhost:11434
