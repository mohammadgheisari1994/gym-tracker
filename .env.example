# Copy to .env for local development. Never commit the real .env.

# SQLAlchemy database URL. docker-compose provides this value automatically;
# set it explicitly when running outside compose.
DATABASE_URL=postgresql+psycopg://gym:gym@localhost:5432/gym

# Set to true only for local debugging.
DEBUG=false

# Default UI language: "en" or "fa".
DEFAULT_LANGUAGE=en

# Signs the session cookie. Generate a fresh random value per deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-insecure-secret-change-me

# Set to true in production (served over HTTPS) so the session cookie is Secure.
SESSION_HTTPS_ONLY=false

# LLM provider for automated form guides / insights / quotes.
#   none    no network calls (default)
#   groq    api.groq.com  (free tier, fast; set LLM_API_KEY)
#   ollama  a local server at LLM_BASE_URL (no key)
#   openai  any OpenAI-compatible endpoint: set LLM_BASE_URL (including the
#           /v1 segment), LLM_API_KEY, and LLM_MODEL. Free options that work:
#             OpenRouter  https://openrouter.ai/api/v1   (models ending ":free")
#             Cerebras    https://api.cerebras.ai/v1
#             Gemini      https://generativelanguage.googleapis.com/v1beta/openai
LLM_PROVIDER=none
LLM_API_KEY=
# Blank uses the preset's default model (groq/ollama). Required for "openai".
LLM_MODEL=
LLM_BASE_URL=http://localhost:11434
